<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-inherit="web.ListRenderer.Rows" t-name="en_base_import.ListRenderer.Rows" t-inherit-mode="extension">
        <xpath expr="//td[hasclass('o_field_x2many_list_row_add')]" position="inside">
            <a href="#"
                t-if="isOne2manySubList"
                role="button"
                class="ml16"
                t-att-tabindex="props.list.editedRecord ? '-1' : '0'"
                t-on-click.stop.prevent="() => this.x2m_import()">Import</a>

            <a href="#"
                t-if="isX2ManySubList"
                role="button"
                class="ml16"
                t-att-tabindex="props.list.editedRecord ? '-1' : '0'"
                t-on-click.stop.prevent="() => this.x2m_export()">Export</a>
        </xpath>
    </t>

</templates>